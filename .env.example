# Amptive-mobile environment configuration
# Copy this file to `.env` and fill in the real values for your environment.
# NEVER commit a real `.env` — only `.env.example` is safe to commit.

# --- API endpoints ---
# Base URL for the REST API (HTTP/HTTPS)
API_BASE_URL=https://amptive-staging.getamptive.com

# Base URL for the WebSocket signaling server (wss:// or ws://)
WS_BASE_URL=wss://amptive.onrender.com

# --- Firebase (used for push notifications) ---
# Firebase project id
FIREBASE_PROJECT_ID=my-amptive

# Firebase app id (platform-specific, e.g. android/ios/web)
FIREBASE_APP_ID=1:423228270595:android:b65b729ef146552113c636

# Firebase Cloud Messaging server key (legacy) / Cloud Messaging sender id
FIREBASE_MESSAGING_SENDER_ID=423228270595

# Firebase API key used by the client SDK
FIREBASE_API_KEY=AIzaSyBHsaLeA0sHmSusVILmIMFySaarkxoPqQY

# Firebase storage bucket
FIREBASE_STORAGE_BUCKET=my-amptive.firebasestorage.app

# --- App behavior toggles ---
# Set to `true` to route all API traffic through a local proxy for debugging
# (leave false in production)
USE_LOCAL_PROXY=false

# Local proxy base URL (only used when USE_LOCAL_PROXY=true)
# LOCAL_PROXY_BASE_URL=http://localhost:3000

# --- Feature flags ---
# Enable verbose network logging ( Dio pretty logger )
ENABLE_HTTP_LOGGING=false

# --- Build-time overrides (passed via --dart-define=...) ---
# These are read by `const String.fromEnvironment` in the codebase.
# API_BASE_URL_OVERRIDE=
# WS_BASE_URL_OVERRIDE=